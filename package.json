{
  "name": "ui-recorder-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Record browser UI operations into an annotated, high-quality video for local playback.",
  "scripts": {
    "record": "node src/record.js",
    "convert": "node src/to-mp4.js",
    "phase2:browser": "node phase2/launch-browser.js",
    "phase2:browser:stop": "node phase2/launch-browser.js --stop",
    "phase2:inspect": "node phase2/launch-browser.js --status",
    "phase2:smoke": "node phase2/mcp-smoke-test.js"
  },
  "dependencies": {
    "ffmpeg-static": "^5.2.0",
    "playwright": "^1.48.0"
  }
}
